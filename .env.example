# ==============================================================================
# Jarvis Agent Plus - Environment Configuration
# ==============================================================================

# 1. API Key (Required for actual LLM calls)
# Supports official OpenAI keys or third-party compatible keys (e.g. DeepSeek, Moonshot, SiliconFlow)
OPENAI_API_KEY=your_actual_api_key_here

# 2. Base URL (Optional - default: https://api.openai.com/v1)
# Examples:
# - Official OpenAI: https://api.openai.com/v1
# - DeepSeek: https://api.deepseek.com/v1
# - Local Ollama: http://localhost:11434/v1
# - OneAPI / NewAPI proxy: https://your-proxy-domain/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Model Name (Optional - default: gpt-4o-mini)
# Examples:
# - gpt-4o-mini / gpt-4o
# - deepseek-chat
# - qwen2.5:7b
OPENAI_MODEL_NAME=gpt-4o-mini
